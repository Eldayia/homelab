# Copie locale unique chargée par ./homelab.
# Créer config/homelab.env avec: ./homelab init

# Hôte et déploiement
HOMELAB_USER=eldayia
HOMELAB_ROOT=/srv/docker
HOST_NAME=rpi4
NM_CONNECTION=netplan-eth0
LAN_ADDRESS=192.168.1.240/24
LAN_GATEWAY=192.168.1.1
LAN_DNS_SERVERS=192.168.1.240,194.242.2.5,1.1.1.1

# SSD local
STORAGE_MOUNT_POINT=/srv
STORAGE_OWNER=eldayia

# NAS QNAP et médias
QNAP_HOST=192.168.1.250
NFS_VERSION=4.1
DOWNLOAD_EXPORT=/Download
MULTIMEDIA_EXPORT=/Multimedia
DOWNLOAD_MOUNT=/mnt/nas/downloads
MULTIMEDIA_MOUNT=/mnt/nas/multimedia

# Sauvegardes
QNAP_EXPORT=/RaspberryBackups
MOUNT_POINT=/mnt/qnap-backups
RESTIC_REPOSITORY=/mnt/qnap-backups/restic-rpi

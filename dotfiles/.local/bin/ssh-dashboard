#!/usr/bin/env bash

# Ne rien afficher dans un terminal non interactif.
[[ -t 1 ]] || exit 0

# Couleurs ANSI.
RESET=$'\e[0m'
BOLD=$'\e[1m'
DIM=$'\e[2m'
CYAN=$'\e[38;5;45m'
BLUE=$'\e[38;5;39m'
GREEN=$'\e[38;5;82m'
YELLOW=$'\e[38;5;220m'
RED=$'\e[38;5;203m'
WHITE=$'\e[38;5;255m'
GRAY=$'\e[38;5;245m'

HOST="$(hostname)"
USER_NAME="$(id -un)"
OS_NAME="$(. /etc/os-release && printf '%s' "$PRETTY_NAME")"
KERNEL="$(uname -r)"
ARCH="$(dpkg --print-architecture 2>/dev/null || uname -m)"
UPTIME="$(uptime -p 2>/dev/null | sed 's/^up //')"
LOAD="$(cut -d ' ' -f 1-3 /proc/loadavg)"
IP_ADDRESS="$(hostname -I 2>/dev/null | awk '{print $1}')"
MODEL="$(tr -d '\0' </sys/firmware/devicetree/base/model 2>/dev/null)"

MEMORY="$(free -h | awk '/^Mem:/ {printf "%s / %s", $3, $2}')"
DISK="$(df -h / | awk 'NR == 2 {printf "%s / %s (%s)", $3, $2, $5}')"
DISK_PERCENT="$(df --output=pcent / | tail -1 | tr -dc '0-9')"

if [[ -r /sys/class/thermal/thermal_zone0/temp ]]; then
    TEMP_RAW="$(< /sys/class/thermal/thermal_zone0/temp)"
    TEMP_C="$((TEMP_RAW / 1000))"
    TEMPERATURE="${TEMP_C}°C"
else
    TEMP_C=0
    TEMPERATURE="indisponible"
fi

if (( TEMP_C >= 75 )); then
    TEMP_COLOR="$RED"
elif (( TEMP_C >= 60 )); then
    TEMP_COLOR="$YELLOW"
else
    TEMP_COLOR="$GREEN"
fi

if (( DISK_PERCENT >= 90 )); then
    DISK_COLOR="$RED"
elif (( DISK_PERCENT >= 75 )); then
    DISK_COLOR="$YELLOW"
else
    DISK_COLOR="$GREEN"
fi

if command -v docker >/dev/null 2>&1; then
    if timeout 2 docker info >/dev/null 2>&1; then
        RUNNING_CONTAINERS="$(
            timeout 2 docker ps --quiet 2>/dev/null |
                awk 'END {print NR + 0}'
        )"
        TOTAL_CONTAINERS="$(
            timeout 2 docker ps --all --quiet 2>/dev/null |
                awk 'END {print NR + 0}'
        )"
        DOCKER_STATUS="${GREEN}actif${RESET} — ${RUNNING_CONTAINERS}/${TOTAL_CONTAINERS} conteneur(s)"
    else
        DOCKER_STATUS="${RED}indisponible${RESET}"
    fi
else
    DOCKER_STATUS="${GRAY}non installé${RESET}"
fi

if command -v apt-get >/dev/null 2>&1; then
    UPDATE_COUNT="$(
        timeout 4 apt-get --simulate upgrade 2>/dev/null |
            awk '/^Inst / {count++} END {print count + 0}'
    )"

    if [[ "$UPDATE_COUNT" =~ ^[0-9]+$ ]] && (( UPDATE_COUNT > 0 )); then
        UPDATE_STATUS="${YELLOW}${UPDATE_COUNT} disponible(s)${RESET}"
    elif [[ "$UPDATE_COUNT" == "0" ]]; then
        UPDATE_STATUS="${GREEN}aucune détectée${RESET}"
    else
        UPDATE_STATUS="${GRAY}vérification indisponible${RESET}"
    fi
fi

printf '\n'

if command -v figlet >/dev/null 2>&1; then
    printf '%s' "$CYAN"
    figlet -f small "$HOST"
    printf '%s' "$RESET"
else
    printf '%s%s%s\n' "$BOLD$CYAN" "$HOST" "$RESET"
fi

printf '%s%s%s\n' "$DIM" '────────────────────────────────────────────────────────' "$RESET"
printf '  %sBienvenue%s, %s%s%s\n' "$WHITE" "$RESET" "$BOLD" "$USER_NAME" "$RESET"

[[ -n "$MODEL" ]] &&
    printf '  %s󰐿  Modèle%s       %s\n' "$BLUE" "$RESET" "$MODEL"

printf '  %s●  Système%s      %s\n' "$BLUE" "$RESET" "$OS_NAME"
printf '  %s●  Noyau%s        %s — %s\n' "$BLUE" "$RESET" "$KERNEL" "$ARCH"
printf '  %s●  Adresse IP%s   %s\n' "$BLUE" "$RESET" "${IP_ADDRESS:-indisponible}"
printf '  %s●  En ligne%s     %s\n' "$BLUE" "$RESET" "$UPTIME"
printf '\n'
printf '  %s●  Charge%s       %s\n' "$CYAN" "$RESET" "$LOAD"
printf '  %s●  Mémoire%s      %s\n' "$CYAN" "$RESET" "$MEMORY"
printf '  %s●  Disque%s       %s%s%s\n' "$CYAN" "$RESET" "$DISK_COLOR" "$DISK" "$RESET"
printf '  %s●  Température%s  %s%s%s\n' "$CYAN" "$RESET" "$TEMP_COLOR" "$TEMPERATURE" "$RESET"
printf '\n'
printf '  %s●  Docker%s       %b\n' "$CYAN" "$RESET" "$DOCKER_STATUS"
printf '  %s●  Mises à jour%s %b\n' "$CYAN" "$RESET" "$UPDATE_STATUS"
printf '%s%s%s\n\n' "$DIM" '────────────────────────────────────────────────────────' "$RESET"
